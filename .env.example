# Reader — Phase 0 Configuration
#
# Infra settings (PostgreSQL, MinIO, RabbitMQ, Agent) are intentionally
# absent here. They are introduced one at a time in the Final Phase
# (see specs/roadmap.md) as each real adapter replaces its Phase 0
# stub / Phase 1-2 local adapter.

# Batch Processing (README §5.1)
BATCH_SIZE=500

# Validation Bounds (README §7.2)
MIN_USERNAME_LENGTH=1
MAX_USERNAME_LENGTH=254
MIN_PASSWORD_LENGTH=1
MAX_PASSWORD_LENGTH=128

# Retry / Backoff (Phase 2 reliability logic)
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=200

# Logging
LOG_LEVEL=info

# --- Infrastructure (MVP phase, -mode=agent only) ---
# Not required for -mode=manual (the default). See
# specs/2026-11-10-mvp/plan.md Groups 5-8.

# PostgreSQL (Final Phase Step A)
DATABASE_DSN=postgres://reader:reader@localhost:5432/reader?sslmode=disable

# MinIO (Final Phase Step B)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reader-files
MINIO_USE_SSL=false

# RabbitMQ (Final Phase Step D)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_FULL_RECORD_TOPIC=reader.full_record
RABBITMQ_UNIQUE_URL_TOPIC=reader.unique_url

# Agent (Final Phase Step C) - endpoint/contract assumed from the
# README; not yet confirmed against a real Agent deployment (see
# specs/2026-11-10-mvp/requirements.md).
AGENT_BASE_URL=https://agent.internal
AGENT_API_KEY=change-me
AGENT_POLL_INTERVAL_SECONDS=10

# Reader Status API (replace the sample key before exposing the endpoint)
READER_API_KEY=replace-this-reader-api-key
READER_API_ADDR=:8080
