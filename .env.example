# Batch Processing
# Supported BATCH_SIZE range: 1-1000 lines per checkpoint batch.
# Start at 500 to balance throughput and replay size. Long lines can cause
# an earlier checkpoint when buffered text reaches 8 MiB.
BATCH_SIZE=500

# Validation Bounds
MIN_USERNAME_LENGTH=1
MAX_USERNAME_LENGTH=254
MIN_PASSWORD_LENGTH=1
MAX_PASSWORD_LENGTH=128

# Retry / Backoff
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=200

# Logging
LOG_LEVEL=info


# PostgreSQL (Compose supplies its own internal DSN)
DATABASE_DSN=postgres://uploader:postgres-dev-password@localhost:5432/reader_db?sslmode=disable

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=uploader
MINIO_SECRET_KEY=uploader-secret
MINIO_BUCKET=uploads
MINIO_USE_SSL=false

# RabbitMQ
# Reader creates missing queues. Set the maximum priority for new unique URL
# queues to match the highest priority the Agent assigns.
RABBITMQ_URL=amqp://admin:admin123@127.0.0.1:5672/
RABBITMQ_FULL_RECORD_TOPIC=reader.full_record
RABBITMQ_UNIQUE_URL_TOPIC=reader.unique_url
RABBITMQ_MAX_PRIORITY=10

# Agent
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_API_KEY=reader-dev-key
AGENT_POLL_INTERVAL_SECONDS=10

# Reader Status API (replace the sample key before exposing the endpoint)
READER_API_KEY=replace-this-reader-api-key
READER_API_ADDR=:8080

# Optional local working directory. Defaults to reader-work under the
# OS temp directory. Compose uses its reader-work volume at /work.
# READER_WORK_DIR=./reader-work

# Log Rotation (retention is one calendar month from registration in UTC)
LOG_ROTATION_INTERVAL=24h
